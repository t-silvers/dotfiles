{{- if eq .shell "bash" }}
{{ template "startup/env" . }}
{{- end }}
{{- if and (eq .os "darwin") (ne (.code | dir) ".") }}
# Add Visual Studio Code (code)
export PATH="$PATH:{{ .code | dir }}"
{{- end }}
export EDITOR="${EDITOR:-vi}"
if [ "${VSCODE_INJECTION:-}" = "1" ] && command -v code &> /dev/null; then
    export EDITOR='code --wait'
fi
{{- if .brew }}
if command -v {{ regexReplaceAllLiteral "^~/" .brew "$HOME/" | quote }} &> /dev/null; then
    eval "$({{ regexReplaceAllLiteral "^~/" .brew "$HOME/" | quote }} shellenv)"
fi
{{- end }}

if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
    export PATH="$HOME/.local/bin:$PATH"
fi
if command -v {{ regexReplaceAllLiteral "^~/" .mise "$HOME/" | quote }} &> /dev/null; then
    eval "$({{ regexReplaceAllLiteral "^~/" .mise "$HOME/" | quote }} activate {{ .shell }} --shims)"
fi
{{- if eq .shell "bash" }}

if [[ $- == *i* ]] && [ -r "$HOME/.bashrc" ]; then
    # shellcheck disable=SC1091
    source "$HOME/.bashrc"
fi
{{- end }}
