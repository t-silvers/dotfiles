{{- if eq .shell "bash" }}
[[ $- == *i* ]] || return 0
{{ template "startup/env" . }}
set -o emacs # set Emacs before interactive widgets/bindings
{{- else if eq .shell "zsh" }}
bindkey -e
{{- end }}
{{ template "startup/interactive" . }}

{{- if eq .hostname "raven" "viper" }}
export TMP="${TMP:-/tmp}"
export TMPPREFIX="${TMPPREFIX:-$TMP/bash}"
export TMPDIR="$TMPPREFIX.${RANDOM}${RANDOM}${RANDOM}"
mkdir -p "$TMPDIR"
chmod 0700 "$TMPDIR"
trap 'rm -rf -- "${TMPDIR:?}"' ABRT EXIT HUP INT QUIT

export MPCDF_DISABLE_MODULE_AVAIL_HINT=1
module use --append "$HOME/soft/modules"
{{- end }}

export HISTSIZE=10000
{{- if eq .shell "bash" }}
export HISTFILESIZE=100000
export HISTTIMEFORMAT=': %Y-%m-%d_%H:%M:%S; '
{{- else if eq .shell "zsh" }}
SAVEHIST=100000
HISTFILE="${HISTFILE:-${ZDOTDIR:-$HOME}/.zsh_history}"
setopt extendedhistory
{{- end }}

{{- if eq .shell "bash" }}
shopt -s autocd
shopt -s dotglob
shopt -s histappend
export HISTCONTROL=ignoreboth:erasedups
set -o noclobber
{{- else if eq .shell "zsh" }}
setopt autocd
setopt dotglob
setopt histignoredups
setopt incappendhistory
setopt interactive_comments
setopt noclobber
{{- end }}

{{ $keyBindings := dict
    "\\C-i" "menu-complete"
    "^[[1;3C" "forward-word"
    "^[[1;3D" "backward-word"
    "^[[A" "history-search-backward"
    "^[[B" "history-search-forward"
    "^[[1;9C" "end-of-line"
    "^[[1;9D" "beginning-of-line" -}}

{{- if eq .shell "bash" -}}
{{   range $k, $m := $keyBindings }}
bind '"{{ $k }}": {{ $m }}'
{{   end }}
{{- else if eq .shell "zsh" -}}
{{   range $k, $m := $keyBindings -}}
bindkey "{{ $k }}" {{ $m | replace "history" "history-beginning" }}
{{   end }}
{{- end }}

alias ..='cd ..'
alias ll='ls -lahF'
alias mv='mv -i'
alias rm='rm -i'

calc() { awk "BEGIN {print \"$* = \" $* }"; }

z() {
    local destination
    destination=$({{ regexReplaceAllLiteral "^~/" .zoxide "$HOME/" | quote }} query --list --score | {{ regexReplaceAllLiteral "^~/" .fzf "$HOME/" | quote }} --bind 'enter:become:echo {2..}') || return
    [ -n "$destination" ] || return
    builtin cd -- "$destination" || return
}
{{- if and (eq .hostname "macbook-air-m2") (eq .shell "zsh") }}

if [ -r "$HOME/Developer/projects/personal/lern/lern_app/shell.zsh" ]; then
    # shellcheck disable=SC1091
    source "$HOME/Developer/projects/personal/lern/lern_app/shell.zsh"
fi
{{- end }}
