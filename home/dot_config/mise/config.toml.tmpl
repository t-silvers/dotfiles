[tools]
"aqua:denisidoro/navi" = { version = "latest", os = ["linux"] }
"cargo:navi" = { version = "latest", os = ["darwin"] } # aqua:denisidoro/navi only compatible w linux and windows
"pipx:httpie/cli" = "latest"
"pipx:psf/black" = "latest"
"pipx:pyscaffold" = "latest"
bats = '1.7'                                # Using flags on `run` requires at least BATS_VERSION=1.5.0.
chezmoi = 'latest'
duckdb = 'latest'
fzf = 'latest'
jq = 'latest'
lychee = 'latest'
oh-my-posh = { version = "latest", os = ["linux"] }
pandoc = 'latest'
pre-commit = 'latest'
python = "3.14"
ripgrep = 'latest'
ruff = 'latest'
rust = ['1.95.0']
shellcheck = 'latest'
task = 'latest'
# tmux = 'latest' # ERROR Failed to install asdf:tmux@latest
tmux = '3.6a'
uv = 'latest'
yamllint = 'latest'
yq = 'latest'
zoxide = 'latest'

{{- if eq .hostname "macbook-air-m2" }}
"aqua:asciinema/agg" = "latest"
"aqua:asciinema/asciinema" = "latest"
"conda:imagemagick" = 'latest'              # asdf:imagemagick fails with error
"github:Fission-AI/OpenSpec" = "latest"
"pipx:copier" = "latest"
"pipx:devpi-server" = "latest"
"pipx:t-silvers/csvkit" = "latest"          # fork with versioned releases
"pipx:tox" = "latest"
# "pipx:wireservice/csvkit" = "latest"
actionlint = 'latest'
antigravity-cli = 'latest'
codex = 'latest'
colima = 'latest'
dasel = 'latest'
docker-cli = 'latest'
fnox = 'latest'
go = ['1.21']
gomplate = 'latest'
hyperfine = 'latest'
miller = 'latest'
node = "26.7"
ollama = 'latest'
postgres = 'latest'
prettier = 'latest'
scie-pants = "latest"
tart = 'latest'
tinytex = 'latest'
tombi = 'latest'
usage = 'latest'
{{- end }}

[settings]
always_keep_install = false
experimental = true
fetch_remote_versions_timeout = '30s'
http_timeout = '30s'
jobs = 2
python.uv_venv_auto = "source"
idiomatic_version_file_enable_tools = ["python"]
raw = false
{{- if eq .hostname "macbook-air-m2" }}
trusted_config_paths = ['~/Developer/projects']
{{- end }}
verbose = false
yes = false

[settings.pipx]
uvx = true

{{- if eq .hostname "macbook-air-m2" }}

[settings.github]
use_git_credentials = true
{{- end }}

[env]
UV_PYTHON = { value = "{{ "{% if tools.python.path is defined %}{{ tools.python.path }}{% else %}{{ tools.python[0].path }}{% endif %}/bin/python" }}", tools = true }
